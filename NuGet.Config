<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Clear the machine-level Visual Studio fallback package folder, which
       points at a nonexistent D:\ path on some machines (causes NU1301).
       nuget.org from the user-level config still applies. -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
